{
  "manifest_version": 3,
  "name": "PrairieLearn Tracker",
  "description": "Track upcoming PrairieLearn assessments across enrolled courses.",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://*.prairielearn.com/*",
    "https://*.prairietest.com/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.prairielearn.com/*"
      ],
      "js": [
        "progress-summary.js",
        "home-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.prairielearn.com/pl/course_instance/*/assessment_instance/*"
      ],
      "js": [
        "assessment-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.prairielearn.com/pl/course_instance/*/instance_question/*"
      ],
      "js": [
        "libs/html2canvas.min.js",
        "question-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.prairietest.com/*"
      ],
      "js": [
        "prairietest-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PrairieLearn Tracker",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "parsing.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prairielearn-tracker@local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
